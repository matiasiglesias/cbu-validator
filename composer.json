{
  "name": "matiasiglesias/cbu-validator",
  "description": "Módulo de Validación de CBU",
  "type": "library",
  "keywords": [
    "cbu",
    "validator",
    "argentina",
    "clave bancaria uniforme",
    "laminas"
  ],
  "license": "MIT",
  "homepage": "https://github.com/matiasiglesias/cbu-validator",
  "support": {
    "source": "https://github.com/matiasiglesias/cbu-validator",
    "issues": "https://github.com/matiasiglesias/cbu-validator/issues"
  },
  "authors": [
    {
      "name": "Matias Iglesias",
      "email": "matiasiglesias@matiasiglesias.com.ar",
      "role": "Developer"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "laminas/laminas-stdlib": "^3.0",
    "laminas/laminas-validator": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "CBUValidator\\": "src/CBUValidator/"
    },
    "classmap": [
      "./Module.php"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
